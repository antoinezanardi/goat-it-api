# Server Configuration
# Host the HTTP server binds to (0.0.0.0 accepts connections on every interface)
SERVER_HOST=0.0.0.0
# Port the HTTP server listens on
SERVER_PORT=3000

# Proxy Trust Configuration
# Reverse proxy peer allowed to set the client address: leave empty to disable proxy trust,
# or set exactly one IPv4/IPv6 address or CIDR block (comma lists, booleans and hop counts are rejected)
TRUST_PROXY=

# CORS Configuration
# Allowed cross-origin browser origin ("*" accepts any origin)
CORS_ORIGIN=*

# MongoDB Database Configuration
# Hostname of the MongoDB server
MONGODB_HOST=0.0.0.0
# Port of the MongoDB server
MONGODB_PORT=27017
# Database name used by the API
MONGODB_DATABASE=goat-it

# Internationalization Configuration
# Locale used when no locale is specified in headers or when desired locale is not available
FALLBACK_LOCALE=en

# Authentication Configuration
# Secret key used for signing API keys (at least 32 characters long)
API_KEY_HMAC_SECRET=hmac_secret_key_for_api_key_signing
# Key used to access admin API endpoints (starts with /admin; at least 24 characters long)
ADMIN_API_KEY=admin_api_key_to_access_admin_endpoints
# Key used to access any other game API endpoints (at least 24 characters long)
GAME_API_KEY=game_api_key_to_access_game_endpoints

# Rate Limiting Configuration
# API-wide per-client budgets applied to every business route; windows are expressed in seconds and budgets in requests.
# Burst tier window in seconds
THROTTLER_DEFAULT_TTL_SECONDS=1
# Burst tier request budget per window
THROTTLER_DEFAULT_LIMIT=20
# Sustained tier window in seconds
THROTTLER_SUSTAINED_TTL_SECONDS=60
# Sustained tier request budget per window
THROTTLER_SUSTAINED_LIMIT=300
