{
  "name": "goat-it-api",
  "version": "1.25.0",
  "description": "🐐 Goat It API is a fast and efficient API built with NestJS and Fastify, designed to provide seamless backend services for Goat It applications.",
  "private": true,
  "keywords": [
    "goat-it",
    "nestjs",
    "fastify",
    "mongodb",
    "api",
    "typescript",
    "backend"
  ],
  "homepage": "https://github.com/antoinezanardi/goat-it-api#readme",
  "bugs": {
    "url": "https://github.com/antoinezanardi/goat-it-api/issues",
    "email": "antoine.zanardi@epitech.eu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antoinezanardi/goat-it-api.git",
    "branch": "main"
  },
  "license": "MIT",
  "author": "Antoine ZANARDI",
  "contributors": [
    {
      "name": "Antoine ZANARDI",
      "email": "antoine.zanardi@epitech.eu",
      "url": "https://antoinezanardi.fr"
    }
  ],
  "maintainers": [
    {
      "name": "Antoine ZANARDI",
      "email": "antoine.zanardi@epitech.eu",
      "url": "https://antoinezanardi.fr"
    }
  ],
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/antoinezanardi"
  },
  "type": "module",
  "main": "dist/main.js",
  "readme": "README.md",
  "engines": {
    "node": ">=26.13.1"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "scripts": {
    "prepare": "scripts/post-install-prepare.sh",
    "build": "nest build --config configs/nest/nest-cli.config.json && tsc-alias -p configs/typescript/tsconfig.app.json --resolve-full-paths",
    "check:secrets-in-built-output": "sh scripts/check-secrets-in-built-output.sh",
    "check:dockerfile-pins": "sh scripts/check-dockerfile-pins.sh",
    "check:dockerignore": "sh scripts/check-dockerignore.sh",
    "check:tracked-env-files": "sh scripts/check-tracked-env-files.sh",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "check:workflows:expressions": "tsx scripts/check-workflow-run-expressions.ts",
    "typecheck": "tsgo -b --clean && tsgo -b --noEmit",
    "start": "nest start --config configs/nest/nest-cli.config.json",
    "start:dev": "nest start --watch --config configs/nest/nest-cli.config.json",
    "start:debug": "nest start --debug --watch --config configs/nest/nest-cli.config.json",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "start:prod:test": "cross-env NODE_ENV=test node dist/main",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint && pnpm run check:workflows:expressions",
    "lint:fix": "pnpm run lint:oxlint:fix && pnpm run lint:eslint:fix",
    "lint:staged:fix": "pnpm run lint:oxlint:staged:fix && pnpm run lint:eslint:staged:fix",
    "lint:eslint": "eslint --config eslint.config.ts",
    "lint:eslint:fix": "eslint --config eslint.config.ts --fix",
    "lint:eslint:staged:fix": "lint-staged -c configs/lint-staged/.lintstagedrc.eslint.json",
    "lint:eslint:inspect-config": "config-inspector",
    "lint:eslint:check-rules": "tsx scripts/check-eslint-rules.ts",
    "lint:oxlint": "oxlint -c oxlint.config.jsonc",
    "lint:oxlint:fix": "oxlint -c oxlint.config.jsonc --fix --fix-suggestions",
    "lint:oxlint:staged:fix": "lint-staged -c configs/lint-staged/.lintstagedrc.oxlint.json",
    "lint:oxlint:check-rules": "tsx scripts/check-oxlint-rules.ts",
    "test": "pnpm run test:unit:cov && pnpm run test:mutation && pnpm run test:acceptance",
    "test:unit": "cross-env NODE_ENV=test vitest --config configs/vitest/vitest.config.ts",
    "test:unit:watch": "cross-env NODE_ENV=test vitest --config configs/vitest/vitest.config.ts --watch",
    "test:unit:cov": "cross-env NODE_ENV=test vitest --config configs/vitest/vitest.config.ts --coverage",
    "test:unit:staged": "lint-staged -c configs/lint-staged/.lintstagedrc.unit-tests.json",
    "test:mutation": "cross-env NODE_ENV=test rimraf tests/mutation/coverage && stryker run configs/stryker/stryker.config.mjs",
    "test:mutation:force": "cross-env NODE_ENV=test rimraf tests/mutation/incremental tests/mutation/coverage && stryker run configs/stryker/stryker.config.mjs --force",
    "test:mutation:ci": "cross-env NODE_ENV=test rimraf tests/mutation/coverage && stryker run configs/stryker/stryker-ci.config.mjs",
    "test:acceptance": "scripts/run-acceptance-tests.sh",
    "test:acceptance:skip-build": "scripts/run-acceptance-tests.sh --skip-build",
    "script:create-branch": "scripts/create-git-branch.sh",
    "script:create-pull-request": "scripts/create-pull-request.sh",
    "script:create-release-changelog": "scripts/create-release-changelog.sh",
    "script:clean-pr-description": "scripts/clean-pr-description.sh",
    "validate:branch-name": "(cd configs/validate-branch-name && validate-branch-name)",
    "docker:build": "docker buildx build -t goat-it-api .",
    "docker:build:linux/arm64": "docker buildx build --platform linux/arm64 -t goat-it-api .",
    "docker:build:linux/amd64": "docker buildx build --platform linux/amd64 -t goat-it-api .",
    "docker:acceptance-tests:start": "docker compose -f docker/goat-it-api-acceptance-tests/docker-compose.yml up -d --wait --wait-timeout 60",
    "docker:acceptance-tests:stop": "docker compose -f docker/goat-it-api-acceptance-tests/docker-compose.yml down",
    "docker:acceptance-tests:reset": "docker compose -f docker/goat-it-api-acceptance-tests/docker-compose.yml down --volumes && pnpm run docker:acceptance-tests:start"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/config-inspector": "^3.5.0",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.10",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^5.1.2",
    "@vitest/eslint-plugin": "^1.6.28",
    "commitlint": "^21.2.4",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-oxlint": "1.95.0",
    "eslint-plugin-unicorn": "^80.0.0",
    "expect": "^30.5.2",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.2",
    "ofetch": "^1.5.1",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "pino-pretty": "^13.2.0",
    "rimraf": "^6.1.4",
    "semantic-release": "^26.0.1",
    "semantic-release-export-data": "^1.2.0",
    "tsc-alias": "^1.9.11",
    "tsx": "^4.23.15",
    "type-fest": "^6.0.3",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "validate-branch-name": "^1.3.2",
    "vitest": "^5.1.2",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.23.0",
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@nestjs/axios": "^12.0.2",
    "@nestjs/common": "^12.6.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.2",
    "@nestjs/mongoose": "^12.0.1",
    "@nestjs/platform-fastify": "^12.6.2",
    "@nestjs/serve-static": "^12.1.1",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/terminus": "^12.2.0",
    "@nestjs/throttler": "^6.8.0",
    "@sentry/nestjs": "^11.17.0",
    "axios": "^1.21.1",
    "cross-env": "^10.1.0",
    "fastify": "^5.12.8",
    "mongoose": "^9.13.1",
    "nestjs-pino": "^5.3.2",
    "nestjs-zod": "^5.6.0",
    "radashi": "^13.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  }
}
