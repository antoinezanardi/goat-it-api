{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "small_model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "orchestrator",
  "experimental": {
    "subagent_depth": 2
  },
  "agent": {
    "explore": {
      "model": "opencode-go/deepseek-v4.1-flash"
    }
  },
  "provider": {
    "opencode-go": {
      "options": {
        "setCacheKey": true
      }
    }
  },
  "plugins": ["@rvboris/opencode-mempalace"],
  "permission": {
    "skill": { "*": "allow" },
    "bash": {
      "*": "ask",
      "git checkout -b *": "allow",
      "git add*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "gh pr merge*": "deny",
      "gh release create*": "deny",
      "gh release delete*": "deny",
      "gh release edit*": "deny",
      "gh release upload*": "deny",
      "gh repo delete*": "deny",
      "gh repo archive*": "deny",
      "gh secret set*": "deny",
      "gh secret delete*": "deny",
      "* .env": "ask",
      "* .env.*": "ask",
      "*/.env": "ask",
      "*/.env.*": "ask",
      "cat env/.env.example": "allow"
    }
  },
  "lsp": {
    "oxlint": {
      "command": ["oxlint", "--lsp"]
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 15000
  }
}
